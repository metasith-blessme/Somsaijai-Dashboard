# Copy the values into the Vercel project (team scope parn), Production.
# Do not commit a filled-in copy.

# From LINE Developers, the Messaging API channel linked to @744byxku
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Bot replies with these when you send: id
LINE_OWNER_USER_ID=
LINE_GROUP_ID=

# Ming's userId from the id reply. Comma-separated. Parn is allowed without being listed.
# Fruit orders are drafted only; the bot never messages suppliers.
LINE_ORDER_SENDER_USER_IDS=

# Same Gemini key the dashboard scripts already use
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.5-flash

# Approve does not write or deploy until this is exactly 1
LINE_BOT_ALLOW_DEPLOY=

# Repo that holds the Excel workbooks
GITHUB_TOKEN=
GITHUB_REPO=metasith-blessme/Somsaijai-Dashboard
GITHUB_BRANCH=main

# Deploy the commit. Scope parn is required for this project.
VERCEL_TOKEN=
VERCEL_SCOPE=parn
VERCEL_PROJECT_ID=

# Created when you connect a Vercel Blob store to the project
BLOB_READ_WRITE_TOKEN=

LINE_BOT_PUBLIC_URL=https://somsaijailive.vercel.app
