{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*).json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "functions": {
    "api/webhook.js": {
      "maxDuration": 300,
      "includeFiles": "{safe_import_sales.js,safe_import_expenses.js,gen_report.js,sync_dashboard_html.js,index.html,stock_ledger.json,xlsx.full.min.js,chart.umd.min.js,Sales_System_Automation/logic/**,Sales_System_Automation/config/**,Sales_System_Automation/ocr-sales-dashboard/scripts/update_dashboard.js,line_bot/**}"
    },
    "api/review.js": { "maxDuration": 30 }
  }
}
